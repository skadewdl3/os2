#!/usr/bin/env bash
shopt -s dotglob

DIST="$PWD/dist"
ESP="$DIST/esp"
BOOT="$ESP/efi/boot"
TARGET="$PWD/target"
BUILD="$TARGET/x86_64-unknown-uefi/debug"

OVMF="${OVMF:-/usr/share/OVMF/x64}"

find_firmware() {
    local directory=$1 file code variables code_name variables_name
    local -a code_files=() variables_files=()

    for file in "$directory"/*OVMF_CODE* "$directory"/*OVMF_VARS* "$directory"/*OVFM_VARS*; do
        [[ -f $file ]] || continue
        case ${file##*/} in
            *OVMF_CODE*) code_files+=("$file") ;;
            *) variables_files+=("$file") ;;
        esac
    done

    # Prefer code and variables files from the same named variant.
    for code in "${code_files[@]}"; do
        code_name=${code##*/}
        for variables in "${variables_files[@]}"; do
            variables_name=${variables##*/}
            variables_name=${variables_name/OVFM_VARS/OVMF_VARS}
            if [[ ${code_name/OVMF_CODE/OVMF_VARS} == "$variables_name" ]]; then
                FIRMWARE_CODE=$code
                FIRMWARE_VARS=$variables
                return 0
            fi
        done
    done

    if (( ${#code_files[@]} == 1 && ${#variables_files[@]} == 1 )); then
        FIRMWARE_CODE=${code_files[0]}
        FIRMWARE_VARS=${variables_files[0]}
        return 0
    fi

    return 1
}

bootstrap() {
    mkdir -p "$BOOT" || return

    if ! find_firmware "$ESP"; then
        if ! find_firmware "$OVMF"; then
            printf 'Cannot select an OVMF firmware pair in %s.\n' "$OVMF" >&2
            return 1
        fi

        echo "Copying OVMF firmware to $ESP"
        cp -- "$FIRMWARE_CODE" "$FIRMWARE_VARS" "$ESP/" || return
    fi

    cargo build || return

    echo "Copying bootloader image to $BOOT..."
    cp -- "$BUILD/os.efi" "$BOOT/bootx64.efi" || return

    echo "Bootstrap done!"
}

qemu() {
    if ! find_firmware "$ESP"; then
        printf 'Cannot select an OVMF firmware pair in %s. Run ./run bootstrap.\n' "$ESP" >&2
        return 1
    fi

    qemu-system-x86_64 -enable-kvm \
        -drive "if=pflash,format=raw,readonly=on,file=${FIRMWARE_CODE//,/,,}" \
        -drive "if=pflash,format=raw,readonly=on,file=${FIRMWARE_VARS//,/,,}" \
        -drive "format=raw,file=fat:rw:${ESP//,/,,}" \
        -display gtk
}

if [[ $1 == "bootstrap" ]]; then
    bootstrap
else
    qemu
fi
