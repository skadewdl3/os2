#!/usr/bin/env bash
ensure_dir() {
    mkdir -p $1
}

DIST="$PWD/dist"
ESP="$DIST/esp"
BOOT="$ESP/efi/boot"
TARGET=$PWD/target
BUILD=$TARGET/x86_64-unknown-uefi/debug

# Change to your OVMF path
OVMF="/usr/share/OVMF/x64"

bootstrap() {
    ensure_dir "$DIST"
    ensure_dir "$ESP"
    ensure_dir "$BOOT"

    # echo "$ESP/OVMF_CODE.*\.fd"

    if [[ ! -n $(find "$ESP" -maxdepth 1 -type f -regex ".*/OVMF_CODE.*\.fd") ]]; then
        cp "$OVMF"/OVMF_CODE*.fd "$ESP/"
    fi

    if [[ ! -n $(find "$ESP" -maxdepth 1 -type f -regex ".*/OVMF_VARS.*\.fd") ]]; then
        cp "$OVMF"/OVMF_VARS*.fd "$ESP/"
    fi

    cp $BUILD/os.efi $BOOT/bootx64.efi
}

qemu() {
    qemu-system-x86_64 -enable-kvm \
        -drive if=pflash,format=raw,readonly=on,file=$ESP/OVMF_CODE.4m.fd \
        -drive if=pflash,format=raw,readonly=on,file=$ESP/OVMF_VARS.4m.fd \
        -drive format=raw,file=fat:rw:$ESP \
        -display gtk
}

if [[ $1 == "bootstrap" ]]; then
    bootstrap
else
    qemu
fi
